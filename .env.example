# Copy to .env and fill in. The agent defaults to the mock provider so you can
# run the whole suite with NO keys and NO cost.

# --- provider ---
# "mock" (default, no network) or "anthropic" or "openai-compatible"
TRIAGE_PROVIDER=mock
TRIAGE_MODEL=mock-model
# TRIAGE_PROVIDER=anthropic
# TRIAGE_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- FREE models via any OpenAI-compatible endpoint (Ollama, OmniRoute, LM Studio) ---
# Requires Ollama running locally: https://ollama.com
# gemma4:31b-cloud is free on Ollama's free plan and takes ~1.5s/step.
# TRIAGE_PROVIDER=openai-compatible
# TRIAGE_BASE_URL=http://127.0.0.1:11434/v1
# TRIAGE_MODEL=gemma4:31b-cloud
# TRIAGE_API_KEY=
#
# Fully local + private, but slow on CPU (~4 min/step for an 8B model):
# TRIAGE_MODEL=llama3.1:8b
#
# OmniRoute / OpenRouter / vLLM: point TRIAGE_BASE_URL at their /v1 and set
# TRIAGE_API_KEY. Nothing else changes.

# --- the "prod" system under investigation ---
TRIAGE_VICTIM_ROOT=victim

# --- guardrails (deny by default) ---
TRIAGE_ALLOWED_TOOLS=query_logs,list_deploys,get_metric,read_file
# run_cmd is the blast radius. Leave OFF unless you are deliberately testing it.
TRIAGE_ALLOW_RUN_CMD=0

# --- budgets ---
TRIAGE_MAX_STEPS=25
TRIAGE_MAX_COST_USD=1.0
TRIAGE_TOOL_TIMEOUT_S=10
