# Copy to .env and fill in. The agent defaults to the mock provider so you can
# run the whole suite with NO keys and NO cost.

# --- provider ---
# "mock" (default, no network) or "anthropic"
TRIAGE_PROVIDER=mock
TRIAGE_MODEL=mock-model
# TRIAGE_PROVIDER=anthropic
# TRIAGE_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- the "prod" system under investigation ---
TRIAGE_VICTIM_ROOT=victim

# --- guardrails (deny by default) ---
TRIAGE_ALLOWED_TOOLS=query_logs,list_deploys,get_metric,read_file
# run_cmd is the blast radius. Leave OFF unless you are deliberately testing it.
TRIAGE_ALLOW_RUN_CMD=0

# --- budgets ---
TRIAGE_MAX_STEPS=25
TRIAGE_MAX_COST_USD=1.0
TRIAGE_TOOL_TIMEOUT_S=10
